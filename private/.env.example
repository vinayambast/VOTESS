# Copy this file to  .env  (same folder as this file, i.e. outside public_html). Never upload real keys to public_html.

SITE_URL=https://yourdomain.com
# Protects api/health.php test mail (optional). Delete api/health.php when setup is done.
HEALTH_KEY=
TRUST_PROXY=0
RATE_LIMIT_PER_HOUR=5
REPLY_SLA=one business day

# ---------- Database: Hostinger MySQL (hPanel > Databases) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_votess
DB_USER=u123456789_votess
DB_PASS=change-me
# AWS RDS / other cloud MySQL: set DB_HOST to the endpoint and DB_SSL_CA to the CA bundle path (see README)
DB_SSL_CA=

# ---------- Email ----------
# smtp | emailjs | smtp_then_emailjs (SMTP first, EmailJS as backup)
MAIL_DRIVER=smtp
MAIL_FROM=hello@yourdomain.com
MAIL_FROM_NAME=VOTESS
REPLY_TO=hello@yourdomain.com
# Comma separated: who receives every new lead and payment alert
ADMIN_EMAILS=admin@yourdomain.com

# Hostinger email: smtp.hostinger.com, port 465 (ssl) or 587 (tls)
# Amazon SES: email-smtp.<region>.amazonaws.com, port 465 (ssl)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=hello@yourdomain.com
SMTP_PASS=change-me

# EmailJS (server-side use needs "Allow EmailJS API for non-browser applications" in Account > Security)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ---------- Payments ----------
PAY_ENV=test
PAY_MAX=500000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET=
PAYU_KEY=
PAYU_SALT=
EASEBUZZ_KEY=
EASEBUZZ_SALT=
UPI_VPA=
UPI_PAYEE_NAME=VOTESS
# Optional: your own static QR image inside public_html, e.g. /assets/upi-qr.png (otherwise a QR is generated)
UPI_QR_IMAGE=

# ---------- Optional cloud forwarding (AWS API Gateway/Lambda, Zapier, n8n ...) ----------
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
